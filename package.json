{
  "name": "genshin-rewards",
  "version": "0.1.0",
  "private": true,
  "description": "原神のHoYoLABログインボーナス受取と交換コード引き換えを自動化する個人用Chrome拡張機能",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/chrome": "0.3.7",
    "@vitest/coverage-v8": "5.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
